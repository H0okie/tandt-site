---
interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "outline" | "outlineLight";
  size?: "md" | "lg";
  class?: string;
  [key: string]: unknown;
}
const { href, variant = "primary", size = "md", class: cls = "", ...rest } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors duration-200";
const variants = {
  primary: "bg-marigold text-loam hover:bg-marigold-dark",
  secondary: "bg-turf text-cream hover:bg-turf-dark",
  outline: "border-2 border-oak text-oak hover:bg-oak hover:text-cream",
  outlineLight: "border-2 border-white/40 text-cream hover:bg-white/10",
};
const sizes = { md: "px-5 py-2.5 text-sm", lg: "px-6 py-3 text-base" };
const cn = [base, variants[variant], sizes[size], cls].join(" ");
const Tag = href ? "a" : "button";
---
<Tag href={href} class={cn} {...rest}><slot /></Tag>
