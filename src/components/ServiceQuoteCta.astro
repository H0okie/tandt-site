---
// Full-width "request a quote" section for the bottom of a service page.
// Replaces the old lg:sticky sidebar card — same offer and copy, now a
// horizontal section so it reads consistently with every other full-bleed
// band on the page instead of floating over the content on scroll.
import { site } from "../config/site";
import Button from "./Button.astro";
---
<section class="bg-[#66BB6A]">
  <div class="container-tt py-20 text-center">
    <h2 class="mx-auto max-w-2xl text-3xl text-cream sm:text-4xl">Request a free quote</h2>
    <p class="mx-auto mt-5 max-w-2xl text-cream/80">
      On-site, no-pressure, and always free. We'll walk your property with you and follow up
      with a clear written quote.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <Button href="/contact/" size="lg">Get a free quote</Button>
      <Button href={site.phoneHref} variant="outlineLight" size="lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5a2 2 0 012-2h2.6a1 1 0 01.95.68l1.2 3.6a1 1 0 01-.5 1.2L8.2 9.6a12 12 0 006.2 6.2l1.12-1.85a1 1 0 011.2-.5l3.6 1.2a1 1 0 01.68.95V18a2 2 0 01-2 2A16 16 0 013 5z"/></svg>
        {site.phone}
      </Button>
    </div>
  </div>
</section>
