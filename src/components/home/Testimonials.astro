---
import { site } from "../../config/site";
import { testimonials } from "../../data/testimonials";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";

const Stars = (n: number) =>
  Array.from({ length: 5 }, (_, i) => (i < n ? "★" : "☆")).join("");
---
<section class="bg-limestone">
  <div class="container-tt py-20">
    <SectionHeading eyebrow="Reviews" title="What Charleston homeowners say" align="center" class="mx-auto max-w-xl" />

    {testimonials.length > 0 ? (
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((t) => (
          <blockquote class="rounded-2xl border border-line bg-white p-6">
            <div class="text-marigold" aria-label={`${t.rating} out of 5 stars`}>{Stars(t.rating)}</div>
            <p class="mt-3 text-loam">&ldquo;{t.quote}&rdquo;</p>
            <footer class="mt-4 text-sm font-semibold text-oak">
              {t.name}{t.location && <span class="font-normal text-stone">, {t.location}</span>}
            </footer>
          </blockquote>
        ))}
      </div>
    ) : (
      <div class="mx-auto mt-10 max-w-xl rounded-2xl border border-line bg-white p-8 text-center">
        <p class="text-lg text-loam">
          We're proud of our reputation across the Charleston area. See what our customers say, or
          tell us about your experience.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <Button href={site.social.facebook} variant="secondary">Read our Facebook reviews</Button>
          <Button href="/contact/" variant="outline">Leave a review</Button>
        </div>
      </div>
    )}
  </div>
</section>
