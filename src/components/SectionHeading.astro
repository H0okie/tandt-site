---
import Sprig from "./Sprig.astro";
interface Props {
  eyebrow?: string;
  title: string;
  align?: "left" | "center";
  light?: boolean;
  class?: string;
}
const { eyebrow, title, align = "left", light = false, class: cls = "" } = Astro.props;
const titleColor = light ? "text-cream" : "text-oak";
---
<div class:list={[align === "center" && "text-center", cls]}>
  <div class:list={["flex items-center gap-2", align === "center" && "justify-center"]}>
    <Sprig size={22} />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  </div>
  <h2 class:list={["mt-3 text-3xl sm:text-4xl", titleColor]}>{title}</h2>
</div>
