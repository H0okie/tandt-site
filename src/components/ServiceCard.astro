---
interface Props { href: string; title: string; description: string; }
const { href, title, description } = Astro.props;
---
<a href={href} class="group flex flex-col rounded-2xl border border-line bg-white p-6 transition-shadow hover:shadow-lg">
  <h3 class="font-display text-lg font-semibold text-oak">{title}</h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-turf transition-colors group-hover:text-turf-dark">
    Learn more <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
  </span>
</a>
