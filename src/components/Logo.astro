---
// Served as a plain static file from /public rather than through Astro's
// <Image> optimizer. The optimizer emits a hashed file into the build-assets
// folder and depends on the image service running at build time; serving the
// webp directly removes that dependency, so the logo can't silently fail on a
// CI/Workers deploy. Explicit width/height prevent layout shift.
import { site } from "../config/site";

interface Props { dark?: boolean; class?: string; }
const { dark = false, class: cls = "" } = Astro.props;

// Source webp is 506×120; display at 34px tall.
const height = 34;
const width = Math.round((height * 506) / 120); // 143
---
<a href="/" class:list={["inline-flex items-center", cls]} aria-label={`${site.name}, home`}>
  <img
    src="/images/brand/tandt-logo.webp"
    alt={site.name}
    width={width}
    height={height}
    decoding="async"
    class:list={["h-[34px] w-auto", dark && "[filter:brightness(0)_invert(1)]"]}
  />
</a>
