---
import { site } from "../config/site";
import Logo from "./Logo.astro";

const year = new Date().getFullYear();
const menu = [
  { label: "Home", href: "/" },
  { label: "About Us", href: "/about/" },
  { label: "News", href: "/blog/" },
  { label: "Contact", href: "/contact/" },
];
const legal = [
  { label: "Privacy Policy", href: "/privacy-policy/" },
  { label: "Terms & Conditions", href: "/terms-service/" },
  { label: "Disclaimer", href: "/disclaimer/" },
];
---
<footer class="bg-oak text-cream/80">
  <div class="container-tt grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <Logo dark />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-cream/70">
        Over {site.yearsExperience}+ years of experience, licensed, bonded, and insured —
        serving Charleston with trusted, professional landscaping.
      </p>
      <div class="mt-5 flex gap-3">
        <a href={site.social.facebook} aria-label="Facebook" class="rounded-full border border-cream/25 p-2 transition-colors hover:bg-cream/10">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 9h3l.4-3H14V4.5c0-.9.3-1.5 1.6-1.5H17V.3C16.7.2 15.8 0 14.7 0 12.3 0 10.7 1.5 10.7 4.2V6H8v3h2.7v9H14V9z"/></svg>
        </a>
        <a href={site.social.instagram} aria-label="Instagram" class="rounded-full border border-cream/25 p-2 transition-colors hover:bg-cream/10">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/><circle cx="17.4" cy="6.6" r="1.2" fill="currentColor"/></svg>
        </a>
      </div>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cream">Menu</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {menu.map((m) => (<li><a href={m.href} class="text-cream/75 transition-colors hover:text-marigold">{m.label}</a></li>))}
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cream">Find us</h2>
      <address class="mt-4 space-y-1 text-sm not-italic text-cream/75">
        <p>{site.address.street}</p>
        <p>{site.address.city}, {site.address.state} {site.address.zip}</p>
      </address>
    </div>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-cream">Contact</h2>
      <ul class="mt-4 space-y-2 text-sm text-cream/75">
        <li><a href={site.phoneHref} class="transition-colors hover:text-marigold">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="transition-colors hover:text-marigold">{site.email}</a></li>
        <li>{site.hoursLabel}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-cream/15">
    <div class="container-tt flex flex-col items-center justify-between gap-3 py-5 text-xs text-cream/60 sm:flex-row">
      <p>Copyright &copy; {year} {site.name}, Serving Charleston SC</p>
      <ul class="flex flex-wrap gap-x-4 gap-y-1">
        {legal.map((l) => (<li><a href={l.href} class="transition-colors hover:text-marigold">{l.label}</a></li>))}
      </ul>
    </div>
  </div>
</footer>
