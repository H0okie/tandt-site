---
import Layout from "../layouts/Layout.astro";
import { site } from "../config/site";
import PageHero from "../components/PageHero.astro";
const updated = "August 2026";
---
<Layout title="Disclaimer" description="Disclaimer for the T&T Lawn & Landscape website.">
  <PageHero title="Disclaimer" breadcrumbs={[{ label: "Home", href: "/" }, { label: "Disclaimer" }]} />
  <section class="bg-cream">
    <div class="container-tt py-16">
      <article class="prose mx-auto max-w-3xl">
        <p><em>Last updated: {updated}</em></p>
        <p>The information provided on {site.url} is for general informational purposes only. All information is provided in good faith; however, we make no representation or warranty of any kind regarding the accuracy or completeness of any information on the site.</p>
        <h2>Professional advice</h2>
        <p>Lawn, landscape, and property recommendations on this site are general in nature. Actual recommendations depend on your specific property, and should be confirmed with our team during an on-site estimate.</p>
        <h2>External links</h2>
        <p>This site may contain links to external websites. We are not responsible for the content or practices of any third-party sites.</p>
        <h2>Contact</h2>
        <p>Questions? Call {site.phone} or email {site.email}.</p>
      </article>
      <p class="mx-auto mt-8 max-w-3xl text-xs text-stone">This is a general template. Please have it reviewed by legal counsel before publishing.</p>
    </div>
  </section>
</Layout>
