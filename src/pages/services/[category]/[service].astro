---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { serviceSchema, breadcrumbList, faqPage } from "../../../lib/schema";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ServiceCard from "../../../components/ServiceCard.astro";
import ServiceFaq from "../../../components/ServiceFaq.astro";
import ServiceWhyUs from "../../../components/ServiceWhyUs.astro";
import ServiceQuoteCta from "../../../components/ServiceQuoteCta.astro";

export async function getStaticPaths() {
  const services = await getCollection("services", ({ data }) => !data.draft);
  const categories = await getCollection("serviceCategories");
  const catById = new Map(categories.map((c) => [c.id, c]));

  return services.map((service) => {
    const category = catById.get(service.data.category.id)!;
    const related = services
      .filter((s) => s.data.category.id === service.data.category.id && s.id !== service.id)
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 3);
    return {
      params: { category: service.data.category.id, service: service.id },
      props: { service, category, related },
    };
  });
}

const { service, category, related } = Astro.props;
const { Content } = await render(service);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services/" },
  { label: category.data.title, href: `/services/${category.id}/` },
  { label: service.data.title },
];
const schema = [
  serviceSchema(service.data.title, service.data.shortDescription, pageUrl),
  breadcrumbList(crumbs),
  ...(service.data.faqs.length > 0 ? [faqPage(service.data.faqs)] : []),
];
const heroImage = service.data.heroImage ?? "/images/site/commercial-landscape-maintenance-charleston-sc.webp";
---
<Layout title={service.data.title} description={service.data.shortDescription} schema={schema}>
  <section class="relative overflow-hidden bg-oak">
    <img src={heroImage} alt="" aria-hidden="true" loading="eager" class="absolute inset-0 h-full w-full object-cover" />
    <div class="absolute inset-0 bg-oak/85"></div>
    <div class="container-tt relative py-14">
      <Breadcrumbs items={crumbs} />
      <h1 class="mt-5 max-w-3xl text-4xl text-cream sm:text-5xl">{service.data.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-cream/80">{service.data.shortDescription}</p>
    </div>
  </section>

  <section class="bg-cream">
    <div class="container-tt py-16">
      <div class="prose prose-xl max-w-none prose-img:rounded-2xl">
        <Content />
      </div>

      {service.data.features.length > 0 && (
        <div class="mt-10">
          <h2 class="font-display text-2xl font-semibold text-oak">What's included</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {service.data.features.map((f) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 flex h-6 w-6 flex-none items-center justify-center rounded-full bg-turf text-cream">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12l4.2 4.2L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="text-loam">{f}</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <ServiceWhyUs
    title={service.data.whyChooseTitle ?? `Why choose T&T for ${service.data.title.toLowerCase()}`}
    points={service.data.whyChoose}
  />

  <ServiceFaq faqs={service.data.faqs} />

  {related.length > 0 && (
    <section class="bg-limestone">
      <div class="container-tt py-16">
        <h2 class="font-display text-2xl font-semibold text-oak">More {category.data.title.toLowerCase()} services</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((s) => (
            <ServiceCard href={`/services/${category.id}/${s.id}/`} title={s.data.title} description={s.data.shortDescription} />
          ))}
        </div>
      </div>
    </section>
  )}
  <ServiceQuoteCta />
</Layout>
