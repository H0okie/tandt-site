---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBanner from "../../components/home/CtaBanner.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<Layout title="News & Tips" description="Lawn care and landscaping tips for the Charleston, SC area from the team at T&T Lawn & Landscape.">
  <PageHero
    title="News & tips"
    subtitle="Seasonal advice and updates from the T&T crew for Charleston-area homeowners."
    breadcrumbs={[{ label: "Home", href: "/" }, { label: "News" }]}
  />
  <section class="bg-cream">
    <div class="container-tt py-20">
      {posts.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="group flex flex-col rounded-2xl border border-line bg-white p-7 transition-shadow hover:shadow-lg">
              <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold uppercase tracking-wider text-marigold">{fmt(post.data.pubDate)}</time>
              <h2 class="mt-2 font-display text-xl font-semibold text-oak">{post.data.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-stone">{post.data.description}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-turf group-hover:text-turf-dark">Read more <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span></span>
            </a>
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-xl rounded-2xl border border-line bg-white p-8 text-center">
          <p class="text-lg text-loam">No posts yet. Check back soon for seasonal lawn and landscaping tips.</p>
        </div>
      )}
    </div>
  </section>
  <CtaBanner />
</Layout>
