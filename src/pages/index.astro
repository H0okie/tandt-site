---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import TrustBar from "../components/home/TrustBar.astro";
import ServicesOverview from "../components/home/ServicesOverview.astro";
import WhyUs from "../components/home/WhyUs.astro";
import Stats from "../components/home/Stats.astro";
import Projects from "../components/home/Projects.astro";
import Testimonials from "../components/home/Testimonials.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/home/Faq.astro";
import CtaBanner from "../components/home/CtaBanner.astro";
import { faqs } from "../data/faqs";
import { faqPage } from "../lib/schema";
---
<Layout schema={[faqPage(faqs)]}>
  <Hero />
  <TrustBar />
  <ServicesOverview />
  <WhyUs />
  <Stats />
  <Projects />
  <Reviews>
    <Testimonials />
  </Reviews>
  <Faq />
  <CtaBanner />
</Layout>
