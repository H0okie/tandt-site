# ==========================================================================
# T&T Lawn & Landscape — Cloudflare Pages response headers
# Copied verbatim into /dist at build time.
# Cloudflare merges all matching blocks; the MORE SPECIFIC path wins on
# conflicting headers, so /tradeup-os/* below overrides the /* cache rule.
# ==========================================================================

# Baseline: applies to every response (HTML + assets).
# HTML is revalidated on each request so a redeploy shows up immediately.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Astro fingerprints these filenames, so they can be cached forever.
/tradeup-os/*
  Cache-Control: public, max-age=31536000, immutable

# Static files served straight from /public.
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# NOTE: A Content-Security-Policy is intentionally NOT set here. The site
# uses inline JSON-LD, an inline contact-form validation script, Google
# Fonts, the Web3Forms POST endpoint, and (optionally) Cloudflare Web
# Analytics. A strict CSP would break these without careful allow-listing,
# so add one only after testing. Starter policy to adapt:
#   Content-Security-Policy: default-src 'self'; img-src 'self' data: https://tandtlawnandlandscape.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://api.web3forms.com; form-action https://api.web3forms.com
