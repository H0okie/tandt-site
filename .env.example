# ==========================================================================
# T&T Lawn & Landscape — environment variables
# Copy this file to `.env` for local dev, and set the same keys in
# Cloudflare Pages → Settings → Environment variables for production.
# Only PUBLIC_* vars are exposed to the browser (that is intended here).
# ==========================================================================

# Contact form delivery (Web3Forms). Free key: https://web3forms.com
# Used as the FALLBACK form until the GoHighLevel embed below is configured.
PUBLIC_WEB3FORMS_KEY=

# GoHighLevel form embed (house standard — submissions land in the CRM).
# GHL → Sites → Forms → your form → Integrate/Embed → copy the iFrame "src" URL
# (e.g. https://api.leadconnectorhq.com/widget/form/XXXXXXXX) and paste it here.
# When set, the contact page uses this instead of the Web3Forms fallback.
# Style the form's fields/colours in the GHL builder — they can't be styled here.
PUBLIC_GHL_FORM_URL=
# Optional: initial iframe height in px (reserves space; GHL's script fine-tunes it).
PUBLIC_GHL_FORM_HEIGHT=760

# Cloudflare Web Analytics beacon token (cookieless, no consent banner).
# Cloudflare dashboard → Web Analytics → add this site → copy the token.
# Until this is set, no analytics script is emitted.
PUBLIC_CF_BEACON_TOKEN=

# Google Tag Manager container (house standard — one container for all tags:
# GA4, Ads/conversion pixels, etc). GTM → your container → copy the ID.
# Note: GTM itself sets no cookies, but tags you fire through it (GA4, Ads) do —
# add a consent mechanism if you serve regions that require one. The Cloudflare
# Web Analytics slot (PUBLIC_CF_BEACON_TOKEN) stays available as a cookieless option.
PUBLIC_GTM_ID=

# Trustindex review widgets. Trustindex → your widget → Embed → copy the loader
# <script> src (https://cdn.trustindex.io/loader.js?XXXX). Style each widget in
# the Trustindex builder — it renders in their DOM and can't be styled from here.
PUBLIC_TRUSTINDEX_WIDGET_SRC=   # in-page reviews block (replaces manual testimonials on the homepage)
PUBLIC_TRUSTINDEX_BADGE_SRC=    # floating badge, site-wide (desktop only)
