# ==========================================================================
# T&T Lawn & Landscape — environment variables
# Copy this file to `.env` for local dev, and set the same keys in
# Cloudflare Pages → Settings → Environment variables for production.
# Only PUBLIC_* vars are exposed to the browser (that is intended here).
# ==========================================================================

# Contact form delivery (Web3Forms). Free key: https://web3forms.com
# Until this is set, the contact form renders but submissions are disabled.
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Web Analytics beacon token (cookieless, no consent banner).
# Cloudflare dashboard → Web Analytics → add this site → copy the token.
# Until this is set, no analytics script is emitted.
PUBLIC_CF_BEACON_TOKEN=
